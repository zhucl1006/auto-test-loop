# Copy to .env for local development. Never commit .env or real credentials.
# npx saves model keys to ~/.config/auto-test-loop/env instead.
# Put account and password in the --goal sentence for that run.
# cp .env.example .env

# Optional explicit selection. The config command writes these.
# AUTOTESTLOOP_DECISION=jev
# AUTOTESTLOOP_ANALYSIS=gemini

# Optional. Jev chooses the element for one action.
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest
JEV_MIN_CONFIDENCE=0.4

# Optional. An LLM plans the flow and diagnoses failures.
# Priority: Gemini, then OpenAI-compatible, then local heuristics.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=
DEEPSEEK_API_KEY=

# Target application. Change these for your project.
WEB_URL=http://127.0.0.1:5173
BFF_URL=http://127.0.0.1:3101

# Test accounts stay in this local file. Leave blank if unused.
TEST_EMAIL=
TEST_PASSWORD=
TEST_USERNAME=
TEST_TENANT_ID=
TEST_PHONE=
TEST_OTP=
# Set explicitly when a target needs it. Do not assume production.
TEST_AUTH_ENV=

# Report prose language. Default is Simplified Chinese when unset.
# AUTOTESTLOOP_REPORT_LANG=zh-CN

# Autonomous CLI step budget.
AUTO_MAX_STEPS=12
