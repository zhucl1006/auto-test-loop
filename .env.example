# Copy to .env for local development. Never commit .env or real credentials.
# npx saves model keys to ~/.config/auto-test-loop/env instead.
# Put account and password in the --goal sentence for that run.
# cp .env.example .env

# Optional explicit selection. The config command writes these.
# AUTOTESTLOOP_DECISION=jev
# AUTOTESTLOOP_ANALYSIS=gemini

# Optional. Jev chooses the element for one action.
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest
JEV_MIN_CONFIDENCE=0.4

# Optional. An LLM plans the flow and diagnoses failures.
# Priority: Gemini, then OpenAI-compatible, then local heuristics.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=
DEEPSEEK_API_KEY=

# Optional local planner. Select Ollama in config, or set AUTOTESTLOOP_ANALYSIS=ollama.
# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# OLLAMA_MODEL=qwen2.5

# Autonomous CLI step budget.
AUTO_MAX_STEPS=12
